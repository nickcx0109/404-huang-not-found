{
  "_about": [
    "Chapter 1, find the car. This file is the palette block \"ch1\" (levels pick it with \"palette\": \"ch1\").",
    "Look: a realistic, dark night on a mountain road. It starts from the chosen mood (heavy) and changes what that look needs; every difference is explained in the PR description.",
    "Fog is brighter than the things standing in it, so trees, wrecks and zombies read as dark silhouettes; the only warm colours are three small lights (camp fire, cabin window, a string of bulbs)."
  ],
  "extends": "mood/heavy",

  "fog": { "color": "#2f3936", "density": 0.056 },
  "hemisphere": { "sky": "#56686a", "ground": "#0b0e0c", "intensity": 0.24 },
  "moon": { "intensity": 0 },
  "flashlight": { "intensity": 3.2, "angle": 19, "penumbra": 0.32, "distance": 34, "decay": 1.3 },
  "post": {
    "exposure": 0.8,
    "saturation": 0.68,
    "vignette": { "strength": 0.8, "start": 0.26, "end": 1.0 },
    "grain": 0.075,
    "chromaticAberration": 0.0025,
    "bloom": { "enabled": true, "threshold": 0.85, "knee": 0.5, "strength": 0.8, "levels": 3 }
  },

  "greybox": {
    "ground": "#20251e",
    "grid": "#20251e",
    "collider": "#3c413d",
    "road": "#34383a",
    "tree": "#141712",
    "car": "#2a2f30",
    "tire": "#101211",
    "truck": "#30373a",
    "crate": "#4a4234",
    "metal": "#24282a",
    "roughness": 0.92,
    "groundRoughness": 0.85,

    "ch1RoadLine": "#8a8672",
    "ch1Rail": "#555b5b",
    "ch1Rust": "#3f2c20",
    "ch1Barrier": "#6f6a5c",
    "ch1BarrierStripe": "#7a2f24",
    "ch1Trash": "#2d2c26",
    "ch1TrashPale": "#69665a",
    "ch1Weed": "#232b1c",
    "ch1Rock": "#2b2f2b",
    "ch1Tent": "#3f4232",
    "ch1Log": "#231c15",
    "ch1CabinDark": "#0c0b0a",
    "ch1Pole": "#1f1d1a",

    "surfaces": {
      "ground": { "texture": "stone", "metres": [5, 5], "roughness": 0.9 },
      "road": { "texture": "asphalt", "metres": [6, 2.2], "roughness": 0.8 },
      "ch1Barrier": { "texture": "concrete", "metres": [2, 1] }
    }
